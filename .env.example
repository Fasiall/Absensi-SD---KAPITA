# Salin file ini menjadi .env lalu sesuaikan nilainya.
# Jangan commit file .env ke git.

# Wajib diganti di produksi. Buat nilai acak, misalnya:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-secret-key-yang-panjang-dan-acak

# Nama sekolah yang tampil di aplikasi dan kartu QR.
SCHOOL_NAME=SD KAPITA

# Zona waktu untuk tanggal dan jam absensi.
APP_TIMEZONE=Asia/Jakarta

# Lokasi database. Kosongkan untuk memakai instance/absensi.db.
# DATABASE_URL=sqlite:///instance/absensi.db

# Set 1 jika aplikasi sudah memakai HTTPS (disarankan di produksi).
SESSION_COOKIE_SECURE=0

# Set 1 untuk mode debug saat pengembangan.
FLASK_DEBUG=0

# Port server lokal.
PORT=5000
